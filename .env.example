# Preserve the working alpha until Nebius credentials, models and credits are verified.
INKRYA_AI_PROVIDER=gateway
AI_GATEWAY_API_KEY=

# Server-only. Get the exact model ID from your authenticated Nebius model catalog.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_TEXT_MODEL=
ROUTER_MODEL=
MEMORY_MODEL=
PLANNER_MODEL=
WRITER_MODEL=
CONTINUITY_MODEL=
CRITIC_MODEL=
QA_MODEL=
# Reserved for Phase 2. This release does not call embeddings.
EMBEDDING_MODEL=

# Explicit opt-in; metadata only. No manuscript, prompts, outputs or raw errors.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=inkrya-hackathon
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=

# Tavily live research (Phase 7). Server-only: the research panel fails closed (503) without
# it, and the key never reaches the browser. Search depth is pinned to `basic` = 1 credit per
# search; one research run makes at most 3 searches, so a run costs at most 3 credits.
TAVILY_API_KEY=

# Separate Tavily credit meter (NOT the 20/24h LLM quota). Both are env-overridable; a blank,
# zero, or non-numeric value is a configuration error rather than a silent default.
TAVILY_DAILY_CREDITS_PER_USER=24
TAVILY_MONTHLY_CREDITS=500

# Existing public Supabase connection remains in lib/supabase.ts and server-auth.ts.
# Do not add a service-role key: current requests rely on user JWTs and RLS.
